---
// Lista numerada a ancho completo: numeral | título (+ detalle) | descripción.
// Las mismas columnas en todas las páginas de servicio, para que los textos arranquen alineados.
interface Item { title: string; body: string; detail?: string }
interface Props { items: Item[] }
const { items } = Astro.props;
const colors = ["text-magenta-600", "text-cyan-600", "text-purple-600", "text-magenta-600"];
---
<div class="border-t border-ink/20">
  {items.map((item, i) => (
    <article class="grid gap-3 border-b border-ink/20 py-7 sm:grid-cols-[4rem_1fr] lg:grid-cols-[4rem_minmax(0,1fr)_minmax(0,1.4fr)] lg:gap-8">
      <span aria-hidden="true" class={`groovy text-4xl ${colors[i % colors.length]}`}>0{i + 1}</span>
      <div>
        <h3 class="text-xl">{item.title}</h3>
        {item.detail && <p class={`mt-3 text-sm font-semibold ${colors[i % colors.length]}`}>{item.detail}</p>}
      </div>
      <p class="prose-lr text-base sm:col-start-2 lg:col-start-auto">{item.body}</p>
    </article>
  ))}
</div>
