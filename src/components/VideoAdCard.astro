---
import Icon from "./Icon.astro";

interface Props {
  title: string;
  hook: string;
  channel: "Meta Ads" | "Google Ads" | "TikTok Ads";
  roas: string;
  cpa: string;
  accent?: string;
  gradient?: string;
}

const {
  title,
  hook,
  channel,
  roas,
  cpa,
  accent = "text-magenta-400",
  gradient = "from-ink via-ink/90 to-magenta-900/60",
} = Astro.props;
---

<div class="group relative aspect-[9/16] w-full overflow-hidden rounded-[2rem] border-2 border-white/15 bg-ink p-5 flex flex-col justify-between shadow-2xl transition duration-300 hover:border-magenta-500/50 hover:shadow-magenta-500/20">
  <!-- Ambient background gradient -->
  <div class={`absolute inset-0 bg-gradient-to-b ${gradient} opacity-90 transition group-hover:scale-105 duration-700`}></div>
  <div class="absolute inset-0 bg-radial from-white/10 to-transparent opacity-40"></div>

  <!-- Top bar -->
  <div class="relative z-10 flex items-center justify-between">
    <span class="rounded-full bg-white/10 px-3 py-1 text-[11px] font-mono font-semibold text-white/90 backdrop-blur border border-white/10">
      {channel}
    </span>
    <span class="flex items-center gap-1 rounded-full bg-lime-400 px-2.5 py-1 text-[10px] font-black text-ink">
      <span class="live-dot" style="background:#190a33"></span> ROAS {roas}
    </span>
  </div>

  <!-- Center Play Interaction -->
  <div class="relative z-10 my-auto text-center">
    <div class="mx-auto mb-3 grid h-14 w-14 place-items-center rounded-full bg-white/15 text-white backdrop-blur-md border border-white/30 transition group-hover:scale-110 group-hover:bg-magenta-500 shadow-xl">
      <svg class="h-6 w-6 fill-current ml-1" viewBox="0 0 24 24">
        <path d="M8 5v14l11-7z"/>
      </svg>
    </div>
    <span class="text-[10px] font-mono tracking-widest text-white/50 uppercase">Formato Vídeo Vertical</span>
    <h4 class="mt-1 font-display font-black text-white text-base sm:text-lg leading-snug px-2">
      "{hook}"
    </h4>
  </div>

  <!-- Bottom campaign metrics card -->
  <div class="relative z-10 rounded-2xl border border-white/15 bg-white/10 p-3.5 backdrop-blur-md">
    <div class="text-[11px] font-bold text-white mb-1">{title}</div>
    <div class="flex items-center justify-between text-[11px] font-mono">
      <span class="text-white/70">Coste/contacto:</span>
      <span class="font-bold text-cyan-300">{cpa}</span>
    </div>
    <div class="mt-1 flex items-center justify-between text-[10px] text-white/50 border-t border-white/10 pt-1">
      <span>Revisión creativa</span>
      <span class="text-lime-300">Trimestral incluida</span>
    </div>
  </div>
</div>
