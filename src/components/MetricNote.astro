---
import Icon from "./Icon.astro";
interface Props { children?: unknown }
---
<div class="flex items-start gap-4 rounded-2xl border border-cyan-500/30 bg-cyan-500/5 p-6">
  <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-cyan-500/15 text-cyan-600">
    <Icon name="target" class="h-5 w-5" />
  </span>
  <div>
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-cyan-600">
      El número que mira el cliente
    </p>
    <p class="mt-1 text-ink/80"><slot /></p>
  </div>
</div>
