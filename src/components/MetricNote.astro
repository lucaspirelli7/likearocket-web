---
import Icon from "./Icon.astro";
interface Props { children?: unknown }
---
<div class="relative flex items-start gap-4 overflow-hidden rounded-2xl border-2 border-cyan-500/30 bg-cyan-500/5 p-6">
  <div class="animate-blob pointer-events-none absolute -right-10 -top-10 h-32 w-32 bg-cyan-500/15 blur-2xl"></div>
  <span class="relative grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-cyan-500 text-white">
    <span class="absolute inset-0 animate-ping rounded-xl bg-cyan-500/40"></span>
    <Icon name="target" class="relative h-5 w-5" />
  </span>
  <div class="relative">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-cyan-600">
      El número que mira el cliente
    </p>
    <p class="mt-1 text-lg font-semibold text-ink/85"><slot /></p>
  </div>
</div>
