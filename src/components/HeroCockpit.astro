---
import Icon from "./Icon.astro";
---

<div class="relative w-full max-w-xl mx-auto lg:max-w-none" id="hero-cockpit">
  <!-- Glowing backlight ambient aura -->
  <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-magenta-500/30 via-purple-500/30 to-cyan-500/30 blur-xl opacity-75 group-hover:opacity-100 transition duration-1000"></div>

  <!-- Main cockpit container -->
  <div class="relative rounded-3xl border border-white/15 bg-ink/90 p-5 sm:p-6 backdrop-blur-xl shadow-2xl">
    <!-- Top HUD status bar -->
    <div class="flex items-center justify-between border-b border-white/10 pb-4 text-xs">
      <div class="flex items-center gap-2">
        <span class="live-dot"></span>
        <span class="font-mono text-white/90 font-semibold tracking-wider uppercase">SISTEMA ACTIVO</span>
      </div>
      <div class="flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-white/60 font-mono text-[11px]">
        <span>ROAS PROMEDIO:</span>
        <span class="font-bold text-lime-400">4.8X</span>
      </div>
    </div>

    <!-- Quick Service Tabs Selector -->
    <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4" id="cockpit-tabs">
      <button
        type="button"
        data-target="web"
        class="cockpit-tab active flex flex-col items-center gap-1 rounded-xl p-2.5 text-center transition border border-magenta-500 bg-magenta-500/20 text-white"
      >
        <span class="text-base">🌐</span>
        <span class="text-xs font-display font-semibold">Diseño Web</span>
      </button>

      <button
        type="button"
        data-target="ads"
        class="cockpit-tab flex flex-col items-center gap-1 rounded-xl p-2.5 text-center transition border border-white/10 bg-white/5 text-white/70 hover:border-white/20 hover:text-white"
      >
        <span class="text-base">🎯</span>
        <span class="text-xs font-display font-semibold">Paid Media</span>
      </button>

      <button
        type="button"
        data-target="geo"
        class="cockpit-tab flex flex-col items-center gap-1 rounded-xl p-2.5 text-center transition border border-white/10 bg-white/5 text-white/70 hover:border-white/20 hover:text-white"
      >
        <span class="text-base">🤖</span>
        <span class="text-xs font-display font-semibold">SEO & GEO</span>
      </button>

      <button
        type="button"
        data-target="social"
        class="cockpit-tab flex flex-col items-center gap-1 rounded-xl p-2.5 text-center transition border border-white/10 bg-white/5 text-white/70 hover:border-white/20 hover:text-white"
      >
        <span class="text-base">📱</span>
        <span class="text-xs font-display font-semibold">Social Media</span>
      </button>
    </div>

    <!-- Dynamic Display Panels -->
    <div class="mt-5 min-h-[260px] rounded-2xl border border-white/10 bg-gradient-to-br from-white/[0.07] to-white/[0.02] p-5">
      <!-- 1. Panel Web -->
      <div id="panel-web" class="cockpit-panel block space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <span class="text-[11px] uppercase tracking-wider text-cyan-400 font-mono">Diseño Web enfocado a conversión</span>
            <h4 class="text-lg font-bold text-white">Web ultrarrápida que vende</h4>
          </div>
          <span class="rounded-full bg-cyan-500/20 px-2.5 py-1 text-xs font-mono font-bold text-cyan-300">Score 99/100</span>
        </div>

        <div class="grid grid-cols-3 gap-2.5 pt-1">
          <div class="rounded-xl border border-white/10 bg-white/5 p-3 text-center">
            <span class="block text-2xl font-black text-magenta-400">0.8s</span>
            <span class="text-[11px] text-white/60">Tiempo de carga</span>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-3 text-center">
            <span class="block text-2xl font-black text-lime-400">+140%</span>
            <span class="text-[11px] text-white/60">Tasa de contacto</span>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-3 text-center">
            <span class="block text-2xl font-black text-cyan-400">100%</span>
            <span class="text-[11px] text-white/60">Móvil primero</span>
          </div>
        </div>

        <div class="flex items-center justify-between rounded-xl bg-white/5 px-4 py-3 border border-white/5">
          <p class="text-xs text-white/80">
            <strong class="text-white">A medida:</strong> Dominio, hosting, textos legales y analítica incluidos.
          </p>
          <a href="/diseno-web" class="shrink-0 text-xs font-bold text-magenta-400 hover:text-magenta-300 flex items-center gap-1">
            Ver portafolio <Icon name="arrow" class="h-3 w-3" />
          </a>
        </div>
      </div>

      <!-- 2. Panel Ads -->
      <div id="panel-ads" class="cockpit-panel hidden space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <span class="text-[11px] uppercase tracking-wider text-magenta-400 font-mono">Google Ads + Meta Ads</span>
            <h4 class="text-lg font-bold text-white">Clientes nuevos entrando cada semana</h4>
          </div>
          <span class="rounded-full bg-magenta-500/20 px-2.5 py-1 text-xs font-mono font-bold text-magenta-300">Cuentas directas</span>
        </div>

        <div class="grid grid-cols-3 gap-2.5 pt-1">
          <div class="rounded-xl border border-white/10 bg-white/5 p-3 text-center">
            <span class="block text-2xl font-black text-lime-400">4.8x</span>
            <span class="text-[11px] text-white/60">ROAS promedio</span>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-3 text-center">
            <span class="block text-2xl font-black text-cyan-400">-42%</span>
            <span class="text-[11px] text-white/60">Coste por lead</span>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-3 text-center">
            <span class="block text-2xl font-black text-magenta-400">100%</span>
            <span class="text-[11px] text-white/60">Tu control total</span>
          </div>
        </div>

        <div class="flex items-center justify-between rounded-xl bg-white/5 px-4 py-3 border border-white/5">
          <p class="text-xs text-white/80">
            <strong class="text-white">Regla Like A Rocket:</strong> El dinero de inversión va en tu cuenta, sin intermediarios.
          </p>
          <a href="/paid-media" class="shrink-0 text-xs font-bold text-cyan-400 hover:text-cyan-300 flex items-center gap-1">
            Ver cómo <Icon name="arrow" class="h-3 w-3" />
          </a>
        </div>
      </div>

      <!-- 3. Panel GEO -->
      <div id="panel-geo" class="cockpit-panel hidden space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <span class="text-[11px] uppercase tracking-wider text-lime-400 font-mono">Generative Engine Optimization</span>
            <h4 class="text-lg font-bold text-white">Posición Top en Google y Buscadores IA</h4>
          </div>
          <span class="rounded-full bg-lime-500/20 px-2.5 py-1 text-xs font-mono font-bold text-lime-400">GEO Ready</span>
        </div>

        <div class="rounded-xl border border-white/10 bg-ink p-3 space-y-1.5 font-mono text-[11px]">
          <div class="text-white/50"># Prompt en ChatGPT / Perplexity:</div>
          <div class="text-white/90">"Recomiéndame los mejores especialistas en tu zona..."</div>
          <div class="text-lime-400 flex items-center gap-1 pt-1 font-bold">
            <span class="text-sm">✓</span> Tu empresa recomendada como fuente verificada #1
          </div>
        </div>

        <div class="flex items-center justify-between rounded-xl bg-white/5 px-4 py-3 border border-white/5">
          <p class="text-xs text-white/80">
            <strong class="text-white">SEO Local + Ficha Google:</strong> Coherencia total de datos y reseñas.
          </p>
          <a href="/seo-local-geo" class="shrink-0 text-xs font-bold text-lime-400 hover:text-lime-300 flex items-center gap-1">
            Ver GEO <Icon name="arrow" class="h-3 w-3" />
          </a>
        </div>
      </div>

      <!-- 4. Panel Social -->
      <div id="panel-social" class="cockpit-panel hidden space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <span class="text-[11px] uppercase tracking-wider text-purple-400 font-mono">Presencia sin esfuerzo</span>
            <h4 class="text-lg font-bold text-white">Redes cuidadas con aprobación previa</h4>
          </div>
          <span class="rounded-full bg-purple-500/20 px-2.5 py-1 text-xs font-mono font-bold text-purple-300">4 a 6 posts/mes</span>
        </div>

        <div class="grid grid-cols-3 gap-2.5 pt-1">
          <div class="rounded-xl border border-white/10 bg-white/5 p-3 text-center">
            <span class="block text-2xl font-black text-magenta-400">100%</span>
            <span class="text-[11px] text-white/60">Visto bueno antes</span>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-3 text-center">
            <span class="block text-2xl font-black text-cyan-400">0h</span>
            <span class="text-[11px] text-white/60">Tiempo perdido</span>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-3 text-center">
            <span class="block text-2xl font-black text-lime-400">+280%</span>
            <span class="text-[11px] text-white/60">Confianza cliente</span>
          </div>
        </div>

        <div class="flex items-center justify-between rounded-xl bg-white/5 px-4 py-3 border border-white/5">
          <p class="text-xs text-white/80">
            <strong class="text-white">Diseño alineado:</strong> Copywriting y creatividades profesionales.
          </p>
          <a href="/social-media" class="shrink-0 text-xs font-bold text-purple-400 hover:text-purple-300 flex items-center gap-1">
            Ver ejemplos <Icon name="arrow" class="h-3 w-3" />
          </a>
        </div>
      </div>
    </div>

    <!-- Live ticker banner at bottom of cockpit -->
    <div class="mt-4 flex items-center justify-between text-[11px] text-white/60 pt-2 border-t border-white/5">
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-lime-400"></span>
        <span>Sin permanencias obligatorias</span>
      </div>
      <div class="font-mono text-cyan-400">Presupuesto caso a caso</div>
    </div>
  </div>

  <!-- Floating decorative badge: top-right -->
  <div class="pointer-events-none absolute -top-5 -right-4 hidden sm:flex items-center gap-2.5 rounded-2xl border border-white/20 bg-ink/90 px-4 py-2.5 backdrop-blur-lg shadow-xl animate-float">
    <div>
      <div class="text-[11px] font-semibold text-white">Despegue digital</div>
      <div class="text-[10px] text-lime-400 font-mono">100% orientado a ventas</div>
    </div>
  </div>

  <!-- Floating decorative badge: bottom-left -->
  <div class="pointer-events-none absolute -bottom-5 -left-4 hidden sm:flex items-center gap-2.5 rounded-2xl border border-white/20 bg-ink/90 px-4 py-2.5 backdrop-blur-lg shadow-xl animate-float" style="animation-delay: -3s;">
    <div class="grid h-8 w-8 place-items-center rounded-xl bg-cyan-500 text-ink font-black text-xs">
      ⚡
    </div>
    <div>
      <div class="text-[11px] font-semibold text-white">Diagnóstico gratuito</div>
      <div class="text-[10px] text-cyan-300 font-mono">Sin compromiso comercial</div>
    </div>
  </div>
</div>

<script>
  function setupCockpit() {
    const tabs = document.querySelectorAll<HTMLButtonElement>("#cockpit-tabs .cockpit-tab");
    const panels = document.querySelectorAll<HTMLElement>(".cockpit-panel");

    const borderColors: Record<string, string> = {
      web: "border-magenta-500",
      ads: "border-cyan-500",
      geo: "border-lime-500",
      social: "border-purple-500"
    };

    const bgColors: Record<string, string> = {
      web: "bg-magenta-500/20",
      ads: "bg-cyan-500/20",
      geo: "bg-lime-500/20",
      social: "bg-purple-500/20"
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.getAttribute("data-target");
        if (!target) return;

        // Reset all tabs
        tabs.forEach((t) => {
          t.classList.remove(
            "border-magenta-500", "bg-magenta-500/20",
            "border-cyan-500", "bg-cyan-500/20",
            "border-lime-500", "bg-lime-500/20",
            "border-purple-500", "bg-purple-500/20",
            "text-white"
          );
          t.classList.add("border-white/10", "bg-white/5", "text-white/70");
        });

        // Activate clicked tab
        tab.classList.remove("border-white/10", "bg-white/5", "text-white/70");
        tab.classList.add(borderColors[target] || "border-magenta-500");
        tab.classList.add(bgColors[target] || "bg-magenta-500/20");
        tab.classList.add("text-white");

        // Switch panels
        panels.forEach((p) => {
          p.classList.add("hidden");
          p.classList.remove("block");
        });

        const activePanel = document.getElementById(`panel-${target}`);
        if (activePanel) {
          activePanel.classList.remove("hidden");
          activePanel.classList.add("block");
        }
      });
    });
  }

  // Setup on standard load and client-router navigation
  document.addEventListener("DOMContentLoaded", setupCockpit);
  document.addEventListener("astro:page-load", setupCockpit);
</script>

