---
import Icon from "./Icon.astro";
import { primaryCta } from "../data/site";
---

<div class="relative overflow-hidden rounded-[2.5rem] border-2 border-ink/10 bg-ink text-white p-6 sm:p-10 lg:p-14 shadow-2xl">
  <!-- Glow background elements -->
  <div class="pointer-events-none absolute -top-24 -right-24 h-96 w-96 rounded-full bg-magenta-500/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-24 -left-24 h-96 w-96 rounded-full bg-cyan-500/20 blur-3xl"></div>

  <div class="relative z-10 grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
    <!-- Left column: Interactive controls -->
    <div>
      <div class="inline-flex items-center gap-2 rounded-full border border-lime-400/30 bg-lime-400/10 px-3.5 py-1 text-xs font-semibold text-lime-300">
        <span class="live-dot"></span> Simulador de Impacto Comercial
      </div>

      <h3 class="mt-4 text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white">
        ¿Cuántos clientes nuevos <span class="text-gradient">estás dejando escapar</span> cada mes?
      </h3>

      <p class="mt-3 text-sm sm:text-base text-white/70 max-w-lg">
        La mayoría de webs locales convierten menos del 0,8 % del tráfico. Con una web rápida pensada para vender y campañas bien optimizadas, los números cambian por completo.
      </p>

      <!-- Calculator controls -->
      <div class="mt-8 space-y-6">
        <!-- 1. Sector Selector -->
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-white/60 mb-2">
            1. Selecciona tu sector
          </label>
          <div class="grid grid-cols-2 gap-2 sm:grid-cols-3" id="calc-sectors">
            <button
              type="button"
              data-rate="3.2"
              class="calc-sector-btn active rounded-button border border-magenta-500 bg-magenta-500/20 px-3 py-2.5 text-xs font-semibold text-white transition text-left"
            >
              💼 Servicios / B2B
            </button>
            <button
              type="button"
              data-rate="3.8"
              class="calc-sector-btn rounded-button border border-white/10 bg-white/5 px-3 py-2.5 text-xs font-semibold text-white/70 hover:border-white/25 hover:text-white transition text-left"
            >
              🩺 Salud / Clínicas
            </button>
            <button
              type="button"
              data-rate="4.2"
              class="calc-sector-btn rounded-button border border-white/10 bg-white/5 px-3 py-2.5 text-xs font-semibold text-white/70 hover:border-white/25 hover:text-white transition text-left"
            >
              🔨 Reformas / Técnicos
            </button>
            <button
              type="button"
              data-rate="4.5"
              class="calc-sector-btn rounded-button border border-white/10 bg-white/5 px-3 py-2.5 text-xs font-semibold text-white/70 hover:border-white/25 hover:text-white transition text-left"
            >
              🍽️ Hostelería / Ocio
            </button>
            <button
              type="button"
              data-rate="2.9"
              class="calc-sector-btn rounded-button border border-white/10 bg-white/5 px-3 py-2.5 text-xs font-semibold text-white/70 hover:border-white/25 hover:text-white transition text-left"
            >
              🏢 Inmobiliaria
            </button>
            <button
              type="button"
              data-rate="3.4"
              class="calc-sector-btn rounded-button border border-white/10 bg-white/5 px-3 py-2.5 text-xs font-semibold text-white/70 hover:border-white/25 hover:text-white transition text-left"
            >
              ⚡ Otro negocio local
            </button>
          </div>
        </div>

        <!-- 2. Slider Visits -->
        <div>
          <div class="flex items-center justify-between text-xs font-semibold text-white/70 mb-2">
            <span class="uppercase tracking-wider">2. Tráfico mensual estimado</span>
            <span class="font-mono text-cyan-300 text-sm font-bold" id="calc-visits-label">1.500 visitas/mes</span>
          </div>
          <input
            type="range"
            id="calc-visits"
            min="200"
            max="8000"
            step="100"
            value="1500"
            class="w-full h-2 rounded-lg bg-white/20 accent-magenta-500 cursor-pointer"
          />
          <div class="mt-1 flex justify-between text-[10px] text-white/40 font-mono">
            <span>200 visitas</span>
            <span>2.500 visitas</span>
            <span>5.000 visitas</span>
            <span>8.000+ visitas</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right column: Dynamic Results Card -->
    <div class="rounded-3xl border border-white/15 bg-white/[0.06] p-6 sm:p-8 backdrop-blur-xl">
      <div class="text-xs uppercase tracking-widest text-cyan-400 font-mono font-semibold">
        Proyección de Captación Estimada
      </div>

      <div class="mt-6 grid grid-cols-2 gap-4">
        <!-- Sin optimizar -->
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
          <span class="text-[11px] text-white/50 block font-medium">Web promedio (0.8%)</span>
          <div class="mt-2 text-2xl sm:text-3xl font-black text-white/50" id="calc-current-leads">12</div>
          <span class="text-[11px] text-white/40">contactos / mes</span>
        </div>

        <!-- Con Like A Rocket -->
        <div class="rounded-2xl border border-lime-400/40 bg-lime-400/10 p-4 relative overflow-hidden">
          <span class="text-[11px] text-lime-300 block font-bold">Con Like A Rocket</span>
          <div class="mt-2 text-3xl sm:text-4xl font-black text-lime-400" id="calc-rocket-leads">48</div>
          <span class="text-[11px] text-lime-300/80 font-medium">contactos / mes</span>
        </div>
      </div>

      <!-- Growth badge -->
      <div class="mt-4 rounded-2xl border border-magenta-500/30 bg-magenta-500/15 p-4 flex items-center justify-between">
        <div>
          <span class="text-xs text-white/70 block">Crecimiento estimado:</span>
          <div class="text-xl sm:text-2xl font-black text-white" id="calc-growth-delta">+36 clientes potenciales/mes</div>
        </div>
        <div class="text-3xl font-black text-magenta-400" id="calc-growth-percent">+300%</div>
      </div>

      <p class="mt-4 text-xs text-white/50 leading-relaxed">
        *Estimación basada en la mejora de velocidad, diseño centrado en conversión (CRO) y captación multicanal (Paid Media + SEO Local).
      </p>

      <a
        href={primaryCta.href}
        class="btn-primary w-full mt-6 text-center text-sm font-bold shadow-lg shadow-magenta-500/25 py-3.5"
      >
        Validar mis números en el diagnóstico gratuito →
      </a>
    </div>
  </div>
</div>

<script>
  function setupCalculator() {
    const visitsInput = document.getElementById("calc-visits") as HTMLInputElement | null;
    const visitsLabel = document.getElementById("calc-visits-label");
    const currentLeads = document.getElementById("calc-current-leads");
    const rocketLeads = document.getElementById("calc-rocket-leads");
    const growthDelta = document.getElementById("calc-growth-delta");
    const growthPercent = document.getElementById("calc-growth-percent");
    const sectorBtns = document.querySelectorAll<HTMLButtonElement>("#calc-sectors .calc-sector-btn");

    if (!visitsInput || !visitsLabel || !currentLeads || !rocketLeads || !growthDelta || !growthPercent) {
      return;
    }

    let activeRate = 3.2; // default rate

    function updateCalculations() {
      if (!visitsInput) return;
      const visits = parseInt(visitsInput.value, 10);
      visitsLabel.textContent = `${visits.toLocaleString("es-ES")} visitas/mes`;

      // Typical unoptimized conversion: 0.8%
      const curr = Math.max(1, Math.round(visits * 0.008));
      // Optimized conversion: activeRate %
      const rock = Math.round(visits * (activeRate / 100));
      const delta = Math.max(0, rock - curr);
      const pct = Math.round(((rock - curr) / curr) * 100);

      currentLeads.textContent = curr.toString();
      rocketLeads.textContent = rock.toString();
      growthDelta.textContent = `+${delta} clientes potenciales/mes`;
      growthPercent.textContent = `+${pct}%`;
    }

    visitsInput.addEventListener("input", updateCalculations);

    sectorBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        sectorBtns.forEach((b) => {
          b.classList.remove("border-magenta-500", "bg-magenta-500/20", "text-white");
          b.classList.add("border-white/10", "bg-white/5", "text-white/70");
        });

        btn.classList.remove("border-white/10", "bg-white/5", "text-white/70");
        btn.classList.add("border-magenta-500", "bg-magenta-500/20", "text-white");

        activeRate = parseFloat(btn.getAttribute("data-rate") || "3.2");
        updateCalculations();
      });
    });

    updateCalculations();
  }

  document.addEventListener("DOMContentLoaded", setupCalculator);
  document.addEventListener("astro:page-load", setupCalculator);
</script>

