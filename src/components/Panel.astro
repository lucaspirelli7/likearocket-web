---
interface Props { title: string; tone?: "magenta" | "cyan" | "lime" | "ink" }
const { title, tone = "magenta" } = Astro.props;
const tones = {
  magenta: "border-magenta-500/30 bg-magenta-500/5",
  cyan: "border-cyan-500/30 bg-cyan-500/5",
  lime: "border-lime-500/50 bg-lime-500/10",
  ink: "border-ink/15 bg-cloud",
};
---
<div class={`relative overflow-hidden rounded-2xl border-2 p-6 sm:p-8 ${tones[tone]}`}>
  <div class="panel-blob animate-float-slow pointer-events-none absolute -right-16 -top-16 h-40 w-40 rounded-full bg-white/40 blur-2xl"></div>
  <h3 class="relative flex items-center gap-3 text-lg">
    {title}
  </h3>
  <div class="prose-lr relative mt-4 space-y-3 text-base"><slot /></div>
</div>
