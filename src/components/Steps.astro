---
interface Step { title: string; body: string }
interface Props { steps: Step[]; title?: string }
const { steps, title } = Astro.props;
const accents = ["text-magenta-500", "text-cyan-500", "text-lime-600", "text-purple-500"];
const bars = ["bg-magenta-500", "bg-cyan-500", "bg-lime-500", "bg-purple-500"];
---
<div>
  {title && <h2 class="text-2xl sm:text-3xl">{title}</h2>}
  <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {steps.map((s, i) => (
      <li class="relative overflow-hidden rounded-2xl border border-ink/10 bg-white p-6">
        <span class={`absolute inset-x-0 top-0 h-1.5 ${bars[i % 4]}`}></span>
        <span class={`groovy text-4xl ${accents[i % 4]}`}>
          {String(i + 1).padStart(2, "0")}
        </span>
        <h3 class="mt-2 text-lg">{s.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink/70">{s.body}</p>
      </li>
    ))}
  </ol>
</div>
