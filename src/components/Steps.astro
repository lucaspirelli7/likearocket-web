---
interface Step { title: string; body: string }
interface Props { steps: Step[]; title?: string }
const { steps, title } = Astro.props;
const accents = ["text-magenta-500", "text-cyan-500", "text-lime-600", "text-purple-500"];
---
<div>
  {title && <h2 class="text-2xl sm:text-3xl">{title}</h2>}
  <ol class="lar-steps mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {steps.map((s, i) => (
      <li
        class="lar-step rounded-2xl border-2 border-ink/10 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:border-ink/20 hover:shadow-xl hover:shadow-ink/5"
        style={`--step-delay:${i * 110}ms`}
      >
        <span class={`groovy block text-4xl ${accents[i % 4]}`}>
          {String(i + 1).padStart(2, "0")}
        </span>
        <h3 class="mt-2 text-lg">{s.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink/70">{s.body}</p>
      </li>
    ))}
  </ol>
</div>

<style is:global>
  .reveal-ready .lar-step {
    opacity: 0;
    transform: translateY(24px) scale(0.97);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--step-delay);
  }
  .reveal-ready .lar-step.is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .reveal-ready .lar-step { opacity: 1 !important; transform: none !important; }
  }
</style>

<script>
  const runSteps = () => {
    document.querySelectorAll<HTMLElement>(".lar-steps").forEach((ol) => {
      const reveal = () => ol.querySelectorAll(".lar-step").forEach((s) => s.classList.add("is-in"));
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            reveal();
            io.disconnect();
          });
        },
        { threshold: 0.2 },
      );
      io.observe(ol);
      setTimeout(reveal, 2500);
    });
  };
  runSteps();
  document.addEventListener("astro:page-load", runSteps);
</script>
