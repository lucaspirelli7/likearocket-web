---
/**
 * Maqueta de sitio web realista dentro de una ventana de navegador (SVG de alta fidelidad).
 * Muestra diseños modernos, tipografía nítida y elementos reales de conversión.
 */
interface Props {
  variant?: 1 | 2 | 3 | 4;
  accent?: string;
  accent2?: string;
  label?: string;
  class?: string;
}

const {
  variant = 1,
  accent = "#f20587",
  accent2 = "#0fc2c0",
  label = "tu-negocio.es",
  class: klass = "",
} = Astro.props;

const ink = "#190a33";
const line = "#e2dcf0";
const page = "#ffffff";

// id único por instancia
const uid = Math.random().toString(36).slice(2, 8);
const gradId = `g-${uid}`;
const clipId = `clip-${uid}`;
---

<svg class={klass} viewBox="0 0 400 290" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={`Maqueta de sitio web — ${label}`}>
  <defs>
    <linearGradient id={gradId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color={accent} />
      <stop offset="100%" stop-color={accent2} />
    </linearGradient>
    <clipPath id={clipId}>
      <rect x="0" y="0" width="400" height="290" rx="12" />
    </clipPath>
  </defs>

  <g clip-path={`url(#${clipId})`}>
    <!-- Fondo blanco general -->
    <rect width="400" height="290" fill={page} />

    <!-- Barra de navegador (Chrome / macOS) -->
    <rect width="400" height="28" fill="#f6f4fa" />
    <circle cx="15" cy="14" r="3.5" fill="#ff5f56" />
    <circle cx="27" cy="14" r="3.5" fill="#ffbd2e" />
    <circle cx="39" cy="14" r="3.5" fill="#27c93f" />

    <!-- Barra de URL con candado seguro -->
    <rect x="56" y="6" width="310" height="16" rx="8" fill="#ffffff" stroke="#e6e0f2" stroke-width="0.8" />
    <text x="68" y="17.5" font-family="'Inter', system-ui, sans-serif" font-size="8.5" fill="#0fc2c0" font-weight="bold">🔒 https://</text>
    <text x="110" y="17.5" font-family="'Inter', system-ui, sans-serif" font-size="8.5" fill="#190a33" font-weight="600">{label}</text>

    <!-- Nav de la web simulada -->
    <rect x="0" y="28" width="400" height="28" fill="#ffffff" />
    <rect x="18" y="37" width="40" height="10" rx="3" fill={ink} />
    <text x="21" y="45" font-family="'Poppins', system-ui, sans-serif" font-size="7" fill="#ffffff" font-weight="800">PORTAL</text>

    <text x="180" y="45" font-family="'Inter', system-ui, sans-serif" font-size="7.5" fill="#6d6582" font-weight="600">Servicios</text>
    <text x="225" y="45" font-family="'Inter', system-ui, sans-serif" font-size="7.5" fill="#6d6582" font-weight="600">Casos</text>
    <text x="260" y="45" font-family="'Inter', system-ui, sans-serif" font-size="7.5" fill="#6d6582" font-weight="600">Contacto</text>

    <rect x="308" y="34" width="74" height="16" rx="8" fill={accent} />
    <text x="320" y="45" font-family="'Poppins', system-ui, sans-serif" font-size="7.5" fill="#ffffff" font-weight="bold">Pedir Cita →</text>
    <line x1="0" y1="56" x2="400" y2="56" stroke={line} stroke-width="0.8" />

    {/* ===================== VARIANTE 1: PORTAL INMOBILIARIO / B2B ===================== */}
    {variant === 1 && (
      <g>
        <rect x="0" y="56" width="400" height="140" fill="#faf8fe" />
        <rect x="18" y="70" width="70" height="12" rx="6" fill="#f20587" fill-opacity="0.12" />
        <text x="25" y="79" font-family="'Poppins', system-ui, sans-serif" font-size="6.5" fill="#f20587" font-weight="bold">EXCLUSIVIDAD</text>

        <text x="18" y="100" font-family="'Poppins', system-ui, sans-serif" font-size="15" fill={ink} font-weight="800">
          Encuentra tu espacio ideal
        </text>
        <text x="18" y="116" font-family="'Inter', system-ui, sans-serif" font-size="8.5" fill="#584e70">
          Gestión personalizada de activos de alta rentabilidad.
        </text>

        <rect x="18" y="130" width="95" height="22" rx="11" fill={accent} />
        <text x="32" y="144" font-family="'Poppins', system-ui, sans-serif" font-size="8" fill="#ffffff" font-weight="bold">Ver catálogo</text>

        <!-- Mockup imagen hero a la derecha -->
        <rect x="225" y="66" width="155" height="116" rx="10" fill={`url(#${gradId})`} />
        <rect x="235" y="145" width="135" height="26" rx="6" fill="#ffffff" fill-opacity="0.95" />
        <text x="245" y="157" font-family="'Poppins', system-ui, sans-serif" font-size="7" fill={ink} font-weight="bold">Centro histórico · 98% Ocupación</text>
        <text x="245" y="166" font-family="'Inter', system-ui, sans-serif" font-size="6.5" fill="#0fc2c0" font-weight="700">★ 4.9 (124 valoraciones)</text>

        <!-- 3 Tarjetas inferiores -->
        <rect x="18" y="206" width="112" height="66" rx="8" fill="#ffffff" stroke={line} />
        <rect x="28" y="216" width="16" height="16" rx="4" fill={accent} fill-opacity="0.15" />
        <text x="33" y="228" font-family="'Inter', system-ui, sans-serif" font-size="9" fill={accent}>🏢</text>
        <text x="28" y="244" font-family="'Poppins', system-ui, sans-serif" font-size="8" fill={ink} font-weight="bold">Oficinas prime</text>
        <text x="28" y="255" font-family="'Inter', system-ui, sans-serif" font-size="7" fill="#6d6582">+30 inmuebles</text>

        <rect x="144" y="206" width="112" height="66" rx="8" fill="#ffffff" stroke={line} />
        <rect x="154" y="216" width="16" height="16" rx="4" fill={accent2} fill-opacity="0.15" />
        <text x="159" y="228" font-family="'Inter', system-ui, sans-serif" font-size="9" fill={accent2}>📐</text>
        <text x="154" y="244" font-family="'Poppins', system-ui, sans-serif" font-size="8" fill={ink} font-weight="bold">Proyectos</text>
        <text x="154" y="255" font-family="'Inter', system-ui, sans-serif" font-size="7" fill="#6d6582">Diseño y reformas</text>

        <rect x="270" y="206" width="112" height="66" rx="8" fill="#ffffff" stroke={line} />
        <rect x="280" y="216" width="16" height="16" rx="4" fill="#dbf227" />
        <text x="285" y="228" font-family="'Inter', system-ui, sans-serif" font-size="9" fill={ink}>⚡</text>
        <text x="280" y="244" font-family="'Poppins', system-ui, sans-serif" font-size="8" fill={ink} font-weight="bold">Respuesta 24h</text>
        <text x="280" y="255" font-family="'Inter', system-ui, sans-serif" font-size="7" fill="#6d6582">Contacto directo</text>
      </g>
    )}

    {/* ===================== VARIANTE 2: ASESORÍA / LEGAL / FISCAL ===================== */}
    {variant === 2 && (
      <g>
        <rect x="0" y="56" width="400" height="140" fill="#190a33" />
        <rect x="18" y="70" width="85" height="12" rx="6" fill="#0fc2c0" fill-opacity="0.2" />
        <text x="24" y="79" font-family="'Poppins', system-ui, sans-serif" font-size="6.5" fill="#0fc2c0" font-weight="bold">ASESORÍA ESTRATÉGICA</text>

        <text x="18" y="100" font-family="'Poppins', system-ui, sans-serif" font-size="15" fill="#ffffff" font-weight="800">
          Tu tranquilidad fiscal y legal
        </text>
        <text x="18" y="116" font-family="'Inter', system-ui, sans-serif" font-size="8.5" fill="#d1cadf">
          Optimizamos tus impuestos y blindamos tu empresa.
        </text>

        <rect x="18" y="130" width="110" height="22" rx="11" fill="#f20587" />
        <text x="28" y="144" font-family="'Poppins', system-ui, sans-serif" font-size="8" fill="#ffffff" font-weight="bold">Solicitar auditoría</text>

        <!-- Visual ilustrativo a la derecha -->
        <rect x="235" y="66" width="145" height="116" rx="10" fill={`url(#${gradId})`} />
        <rect x="245" y="76" width="60" height="14" rx="4" fill="#ffffff" fill-opacity="0.9" />
        <text x="250" y="86" font-family="'Inter', system-ui, sans-serif" font-size="7" fill={ink} font-weight="bold">Ahorro 28%</text>

        <!-- Fila de métricas clave -->
        <rect x="18" y="206" width="364" height="66" rx="8" fill="#faf8fe" stroke={line} />
        <text x="35" y="232" font-family="'Poppins', system-ui, sans-serif" font-size="18" fill="#f20587" font-weight="900">+450</text>
        <text x="35" y="248" font-family="'Inter', system-ui, sans-serif" font-size="8" fill="#584e70">Empresas asesoradas</text>

        <text x="165" y="232" font-family="'Poppins', system-ui, sans-serif" font-size="18" fill="#0fc2c0" font-weight="900">100%</text>
        <text x="165" y="248" font-family="'Inter', system-ui, sans-serif" font-size="8" fill="#584e70">Digital y sin papeles</text>

        <text x="290" y="232" font-family="'Poppins', system-ui, sans-serif" font-size="18" fill="#a054f6" font-weight="900">4.9/5</text>
        <text x="290" y="248" font-family="'Inter', system-ui, sans-serif" font-size="8" fill="#584e70">En Google Reviews</text>
      </g>
    )}

    {/* ===================== VARIANTE 3: RESTAURANTE / HOSTELERÍA / RESERVAS ===================== */}
    {variant === 3 && (
      <g>
        <rect x="0" y="56" width="400" height="145" fill="#faf8fe" />
        <rect x="18" y="68" width="90" height="12" rx="6" fill="#dbf227" />
        <text x="24" y="77" font-family="'Poppins', system-ui, sans-serif" font-size="6.5" fill={ink} font-weight="800">COCINA DE TEMPORADA</text>

        <text x="18" y="98" font-family="'Poppins', system-ui, sans-serif" font-size="15" fill={ink} font-weight="800">
          Sabores que conquistan
        </text>
        <text x="18" y="112" font-family="'Inter', system-ui, sans-serif" font-size="8.5" fill="#584e70">
          Producto fresco de proximidad en el corazón de la ciudad.
        </text>

        <rect x="18" y="126" width="90" height="20" rx="10" fill={accent} />
        <text x="28" y="139" font-family="'Poppins', system-ui, sans-serif" font-size="7.5" fill="#ffffff" font-weight="bold">Reservar mesa</text>

        <!-- Tarjeta flotante con formulario simulado -->
        <rect x="230" y="64" width="150" height="125" rx="10" fill="#ffffff" stroke={line} filter="drop-shadow(0 4px 12px rgba(25,10,51,0.08))" />
        <rect x="242" y="74" width="126" height="12" rx="3" fill="#f4f2f8" />
        <text x="248" y="83" font-family="'Poppins', system-ui, sans-serif" font-size="7" fill={ink} font-weight="bold">Reserva online directa</text>

        <rect x="242" y="92" width="60" height="16" rx="4" fill="#faf8fe" stroke={line} />
        <text x="248" y="103" font-family="'Inter', system-ui, sans-serif" font-size="6.5" fill="#584e70">📅 Hoy</text>

        <rect x="308" y="92" width="60" height="16" rx="4" fill="#faf8fe" stroke={line} />
        <text x="314" y="103" font-family="'Inter', system-ui, sans-serif" font-size="6.5" fill="#584e70">👥 2 Personas</text>

        <rect x="242" y="114" width="126" height="16" rx="4" fill="#faf8fe" stroke={line} />
        <text x="248" y="125" font-family="'Inter', system-ui, sans-serif" font-size="6.5" fill="#584e70">⏰ 21:30h disponible</text>

        <rect x="242" y="136" width="126" height="18" rx="6" fill={accent} />
        <text x="268" y="148" font-family="'Poppins', system-ui, sans-serif" font-size="7" fill="#ffffff" font-weight="bold">Confirmar reserva</text>

        <!-- Franja inferior de platos destacados -->
        <rect x="18" y="210" width="364" height="60" rx="8" fill={`url(#${gradId})`} />
        <text x="35" y="235" font-family="'Poppins', system-ui, sans-serif" font-size="11" fill="#ffffff" font-weight="bold">Menú degustación de otoño</text>
        <text x="35" y="250" font-family="'Inter', system-ui, sans-serif" font-size="8" fill="#ffffff" fill-opacity="0.9">Maridaje exclusivo · Plazas limitadas</text>
      </g>
    )}

    {/* ===================== VARIANTE 4: CLÍNICA / SALUD / SERVICIOS TÉCNICOS ===================== */}
    {variant === 4 && (
      <g>
        <rect x="0" y="56" width="400" height="140" fill="#faf8fe" />
        <rect x="18" y="70" width="70" height="12" rx="6" fill="#0fc2c0" fill-opacity="0.15" />
        <text x="24" y="79" font-family="'Poppins', system-ui, sans-serif" font-size="6.5" fill="#0fc2c0" font-weight="bold">SALUD & BIENESTAR</text>

        <text x="18" y="100" font-family="'Poppins', system-ui, sans-serif" font-size="15" fill={ink} font-weight="800">
          Cuidamos de tu sonrisa
        </text>
        <text x="18" y="115" font-family="'Inter', system-ui, sans-serif" font-size="8.5" fill="#584e70">
          Tecnología avanzada y especialistas de primer nivel.
        </text>

        <rect x="18" y="130" width="95" height="22" rx="11" fill="#0fc2c0" />
        <text x="30" y="144" font-family="'Poppins', system-ui, sans-serif" font-size="8" fill="#ffffff" font-weight="bold">Primera consulta</text>

        <rect x="235" y="66" width="145" height="116" rx="10" fill={`url(#${gradId})`} />
        <rect x="245" y="142" width="125" height="24" rx="6" fill="#ffffff" fill-opacity="0.95" />
        <text x="252" y="154" font-family="'Poppins', system-ui, sans-serif" font-size="7" fill={ink} font-weight="bold">Diagnóstico 3D sin coste</text>
        <text x="252" y="162" font-family="'Inter', system-ui, sans-serif" font-size="6" fill="#f20587" font-weight="700">★ 5.0 (210 opiniones)</text>

        <!-- Rejilla 2x2 de especialidades -->
        <rect x="18" y="206" width="176" height="30" rx="6" fill="#ffffff" stroke={line} />
        <text x="28" y="222" font-family="'Poppins', system-ui, sans-serif" font-size="7.5" fill={ink} font-weight="bold">Implantes avanzados</text>
        <text x="28" y="231" font-family="'Inter', system-ui, sans-serif" font-size="6.5" fill="#0fc2c0">En 24 horas</text>

        <rect x="206" y="206" width="176" height="30" rx="6" fill="#ffffff" stroke={line} />
        <text x="216" y="222" font-family="'Poppins', system-ui, sans-serif" font-size="7.5" fill={ink} font-weight="bold">Ortodoncia invisible</text>
        <text x="216" y="231" font-family="'Inter', system-ui, sans-serif" font-size="6.5" fill="#f20587">Resultados en meses</text>

        <rect x="18" y="242" width="176" height="30" rx="6" fill="#ffffff" stroke={line} />
        <text x="28" y="258" font-family="'Poppins', system-ui, sans-serif" font-size="7.5" fill={ink} font-weight="bold">Estética dental</text>
        <text x="28" y="267" font-family="'Inter', system-ui, sans-serif" font-size="6.5" fill="#a054f6">Carillas cerámicas</text>

        <rect x="206" y="242" width="176" height="30" rx="6" fill="#ffffff" stroke={line} />
        <text x="216" y="258" font-family="'Poppins', system-ui, sans-serif" font-size="7.5" fill={ink} font-weight="bold">Odontopediatría</text>
        <text x="216" y="267" font-family="'Inter', system-ui, sans-serif" font-size="6.5" fill="#dbf227" fill-opacity="0.9">Atención infantil</text>
      </g>
    )}
  </g>

  <!-- Borde exterior suave -->
  <rect x="0.5" y="0.5" width="399" height="289" rx="12" fill="none" stroke={line} stroke-width="1" />
</svg>
