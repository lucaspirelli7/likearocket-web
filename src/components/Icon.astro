    '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/>',
  target:
    '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.2"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>',
  map: '<path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Z"/><path d="M9 4v14M15 6v14"/>',
  chat: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.4A8 8 0 1 1 21 12Z"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01"/>',
  rocket:
    '<path d="M5 14c-1.5 1.5-2 5-2 5s3.5-.5 5-2M9 15l-3-3M15 9l3 3"/><path d="M14.5 4.5C17 2 21 3 21 3s1 4-1.5 6.5L12 17l-5-5 7.5-7.5Z"/><circle cx="14.5" cy="9.5" r="1.5"/>',
  check: '<path d="m5 13 4 4L19 7"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  phone:
    '<path d="M15.5 21A16 16 0 0 1 3 8.5 3 3 0 0 1 6 5.5h2l1.5 4-2 1.5a12 12 0 0 0 5 5l1.5-2 4 1.5v2a3 3 0 0 1-2.5 3Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  whatsapp:
    '<path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.5L3 20l1.1-5.2A8.5 8.5 0 1 1 21 11.5Z"/><path d="M8.5 8.5c1 3.5 3.5 6 7 7l1.5-2-2.5-1-1 1a7 7 0 0 1-3-3l1-1-1-2.5-2 1.5Z"/>',
};
---

<svg
  class={klass}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
