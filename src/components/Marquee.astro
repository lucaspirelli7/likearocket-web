---
interface Props {
  items: string[];
  reverse?: boolean;
  class?: string;
}
const { items, reverse = false, class: klass = "" } = Astro.props;
const loop = [...items, ...items];
---
<div class:list={["marquee", reverse && "marquee--reverse", klass]} aria-hidden="true">
  <div class="marquee__track">
    {loop.map((it) => (
      <span class="flex items-center gap-2.5 whitespace-nowrap font-display text-sm font-bold uppercase tracking-widest">
        {it}
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="currentColor"><path d="M12 2 9.2 9.2 2 12l7.2 2.8L12 22l2.8-7.2L22 12l-7.2-2.8Z"/></svg>
      </span>
    ))}
  </div>
</div>
