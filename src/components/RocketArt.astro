---
// Cohete decorativo de marca (turquesa) con estela animada.
interface Props { class?: string }
const { class: klass = "h-40 w-40" } = Astro.props;
---
<svg class={klass} viewBox="0 0 200 260" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <!-- estela -->
  <g class="animate-trail">
    <path d="M100 196c-10 14-13 34-13 34s16-6 24-18c-4 10-3 22-3 22s12-10 15-24c2 8 8 14 8 14s6-16 0-30l-31-4Z" fill="#DBF227"/>
    <path d="M100 196c-6 10-8 24-8 24s10-5 15-13c-2 7-1 15-1 15s8-7 10-16l-16-14Z" fill="#F20587"/>
  </g>
  <!-- cuerpo -->
  <path d="M100 8c22 20 34 50 34 92v58a34 34 0 0 1-68 0V100C66 58 78 28 100 8Z" fill="#0FC2C0"/>
  <path d="M100 8c22 20 34 50 34 92v58a34 34 0 0 1-34 34V8Z" fill="#0a9694" opacity="0.35"/>
  <!-- aletas -->
  <path d="M66 128 40 168v34l26-14 3-60z" fill="#0FC2C0"/>
  <path d="M134 128 160 168v34l-26-14-3-60z" fill="#0FC2C0"/>
  <!-- ventana -->
  <circle cx="100" cy="86" r="18" fill="#fff"/>
  <circle cx="100" cy="86" r="18" stroke="#190a33" stroke-width="3" opacity="0.1"/>
  <circle cx="93" cy="79" r="6" fill="#DBF227"/>
</svg>
