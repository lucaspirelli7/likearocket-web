---
import Icon from "./Icon.astro";
interface Props { items: string[]; tone?: "check" | "cross" }
const { items, tone = "check" } = Astro.props;
// Con un número impar de elementos, el último ocupa las dos columnas: sin hueco huérfano.
const oddLast = items.length % 2 === 1;
---
<ul class="grid gap-3 sm:grid-cols-2">
  {items.map((it, i) => (
    <li class={`group flex items-start gap-3 rounded-xl border-2 border-ink/10 bg-white p-4 text-sm leading-relaxed text-ink/80 transition duration-200 hover:-translate-y-0.5 hover:border-cyan-500/40 hover:shadow-lg hover:shadow-ink/5 ${oddLast && i === items.length - 1 ? "sm:col-span-2" : ""}`}>
      <span class={`mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full transition group-hover:scale-110 ${tone === "check" ? "bg-cyan-500/15 text-cyan-600 group-hover:bg-cyan-500 group-hover:text-white" : "bg-ink/10 text-ink/50"}`}>
        <Icon name={tone === "check" ? "check" : "arrow"} class="h-3 w-3" />
      </span>
      {it}
    </li>
  ))}
</ul>
