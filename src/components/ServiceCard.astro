---
import type { Service } from "../data/services";
import Icon from "./Icon.astro";
interface Props { service: Service }
const { service } = Astro.props;

const accent = {
  magenta: "text-magenta-500 bg-magenta-500/10 group-hover:bg-magenta-500 group-hover:text-white",
  cyan: "text-cyan-600 bg-cyan-500/10 group-hover:bg-cyan-500 group-hover:text-white",
  lime: "text-lime-600 bg-lime-500/20 group-hover:bg-lime-500 group-hover:text-ink",
}[service.accent];
const bar = {
  magenta: "bg-magenta-500",
  cyan: "bg-cyan-500",
  lime: "bg-lime-500",
}[service.accent];
---

<a
  href={`/${service.slug}`}
  class="group card-hover relative flex h-full flex-col overflow-hidden rounded-2xl border-2 border-ink/10 bg-white p-6 hover:border-ink/20"
>
  <span class={`absolute inset-x-0 top-0 h-1.5 origin-left scale-x-0 transition-transform duration-300 group-hover:scale-x-100 ${bar}`}></span>
  <span class={`grid h-12 w-12 place-items-center rounded-xl transition-colors duration-300 ${accent}`}>
    <Icon name={service.icon} class="h-6 w-6" />
  </span>
  <h3 class="mt-5 text-xl">{service.name}</h3>
  <p class="mt-1 text-sm font-semibold text-ink/50">{service.descriptor}</p>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-ink/70">{service.promise}</p>
  <span class="link-arrow mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-magenta-600">
    Ver servicio
    <Icon name="arrow" class="h-4 w-4" />
  </span>
</a>
