---
import type { Service } from "../data/services";
import Icon from "./Icon.astro";
interface Props { service: Service }
const { service } = Astro.props;

const accent = {
  magenta: "text-magenta-500 bg-magenta-500/10",
  cyan: "text-cyan-600 bg-cyan-500/10",
  lime: "text-lime-600 bg-lime-500/15",
}[service.accent];
---

<a
  href={`/${service.slug}`}
  class="group flex flex-col rounded-2xl border border-ink/10 bg-white p-6 transition hover:border-ink/25 hover:shadow-xl hover:shadow-ink/5"
>
  <span class={`grid h-11 w-11 place-items-center rounded-xl ${accent}`}>
    <Icon name={service.icon} class="h-6 w-6" />
  </span>
  <h3 class="mt-5 text-xl">{service.name}</h3>
  <p class="mt-1 text-sm font-semibold text-ink/50">{service.descriptor}</p>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-ink/70">{service.promise}</p>
  <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-magenta-600">
    Ver servicio
    <Icon name="arrow" class="h-4 w-4 transition group-hover:translate-x-1" />
  </span>
</a>
