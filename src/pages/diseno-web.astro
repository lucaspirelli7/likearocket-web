---
import ServiceLayout from "../layouts/ServiceLayout.astro";
import Steps from "../components/Steps.astro";
import CheckList from "../components/CheckList.astro";
import SiteMockup from "../components/SiteMockup.astro";

const M = "#f20587";
const C = "#0fc2c0";
const L = "#dbf227";
const P = "#a054f6";

const portfolio = [
  { name: "Asesoría local", tag: "Web corporativa + captación", variant: 2, a: P, b: C, url: "asesoria-vega.es" },
  { name: "Restaurante", tag: "Landing + reservas", variant: 3, a: M, b: L, url: "lacocinade.es" },
  { name: "Clínica", tag: "Web multiservicio", variant: 4, a: C, b: P, url: "clinicasalud.es" },
  { name: "Inmobiliaria", tag: "Portal de contacto", variant: 1, a: P, b: M, url: "fincasdelnorte.es" },
  { name: "Turismo rural", tag: "Web + motor de reserva", variant: 3, a: L, b: C, url: "casaruralrocket.es" },
  { name: "Servicios técnicos", tag: "Landing de campaña", variant: 4, a: M, b: P, url: "reformas-express.es" },
] as const;

const proceso = [
  { title: "Nos cuentas tu caso", body: "Qué haces, a quién te diriges y qué quieres que consiga la web. Reunimos referencias y accesos." },
  { title: "Primera propuesta", body: "En 1–2 semanas ves el diseño de las páginas clave. Aún a tiempo de cambiar el rumbo." },
  { title: "Dos rondas de ajustes", body: "Revisamos juntos, tú marcas cambios y los aplicamos. Sin rondas infinitas: el proceso está acotado." },
  { title: "Publicación", body: "Dominio, alojamiento, textos legales y medición listos. Te enseñamos a editar lo del día a día." },
];
---

<ServiceLayout
  slug="diseno-web"
  intro="Esta página se vende viéndose, no leyéndose. El bloque principal es el portafolio: mira lo que hacemos y hablamos de tu proyecto. Cada web se presupuesta caso a caso, sin paquete cerrado."
>
  <section>
    <span class="eyebrow">Trabajos anteriores</span>
    <h2 class="mt-3 text-2xl sm:text-3xl">Webs que ya están trabajando para su negocio.</h2>
    <p class="prose-lr mt-3 max-w-2xl">
      Una muestra por sector. <em>Marcadores de posición</em>: son maquetas de ejemplo; antes
      del lanzamiento se sustituyen por capturas y enlaces de proyectos reales.
    </p>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {portfolio.map((p) => (
        <figure class="group card-hover overflow-hidden rounded-2xl border-2 border-ink/10 bg-white">
          <div class="overflow-hidden bg-cloud p-3">
            <SiteMockup
              variant={p.variant}
              accent={p.a}
              accent2={p.b}
              label={p.url}
              class="w-full rounded-lg shadow-sm transition-transform duration-500 group-hover:scale-[1.03]"
            />
          </div>
          <figcaption class="border-t border-ink/10 px-4 py-4">
            <p class="font-display font-semibold">{p.name}</p>
            <p class="text-sm text-ink/55">{p.tag}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section>
    <span class="eyebrow">Qué hacemos</span>
    <h2 class="mt-3 text-2xl sm:text-3xl">De una landing de campaña a una web completa.</h2>
    <p class="prose-lr mt-3 max-w-2xl">
      Según lo que necesite tu negocio ahora. Todo lo necesario para publicar va incluido en el presupuesto:
    </p>
    <div class="mt-6">
      <CheckList items={[
        "Diseño a medida, pensado para que el visitante contacte",
        "Dominio y alojamiento gestionados",
        "Textos legales: aviso legal, privacidad y cookies",
        "Carga rápida y buena base para SEO",
        "Medición de formularios y llamadas desde el primer día",
        "Formación para que edites el contenido del día a día",
      ]} />
    </div>
  </section>

  <section>
    <span class="eyebrow">El proceso</span>
    <h2 class="mt-3 text-2xl sm:text-3xl">Claro de principio a fin.</h2>
    <p class="prose-lr mt-3 max-w-2xl">
      Cuanto más claro el proceso, menos miedo da que el presupuesto sea a medida. Estos son los pasos:
    </p>
    <div class="mt-8"><Steps steps={proceso} /></div>
  </section>
</ServiceLayout>
