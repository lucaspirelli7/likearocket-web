---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import CtaSection from "../components/CtaSection.astro";
import { publishableResults } from "../data/results";
const cases = publishableResults();
---

<BaseLayout
  title="Resultados"
  description="Casos reales de Like A Rocket, contados por sector: punto de partida, qué hicimos y qué pasó."
>
  <section class="bg-ink text-white">
    <div class="container-page py-16 lg:py-24">
      <span class="eyebrow text-cyan-400"><Icon name="target" class="h-4 w-4" /> Resultados</span>
      <h1 class="mt-5 max-w-3xl text-4xl leading-tight sm:text-5xl">
        Casos reales, sin pared de logos.
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-white/70">
        Cada ficha sigue el mismo formato: sector, punto de partida, qué hicimos y qué pasó.
        Cuando no tenemos permiso para dar el nombre, publicamos el caso solo por sector.
      </p>
    </div>
  </section>

  <div class="container-page py-16 sm:py-20">
    <div class="mb-10 flex items-start gap-3 rounded-2xl border border-gold-500/40 bg-gold-500/10 p-5 text-sm text-ink/75">
      <Icon name="rocket" class="mt-0.5 h-5 w-5 shrink-0 text-gold-500" />
      <p>
        <strong>Nota para el equipo (quitar antes de lanzar):</strong> los casos de abajo están
        redactados sin cifras porque aún no están verificadas ni autorizadas. Confirmar permisos
        y métricas reales con cada cliente antes de publicar.
      </p>
    </div>

    <div class="space-y-6">
      {cases.map((c) => (
        <article class="rounded-3xl border border-ink/10 bg-white p-6 sm:p-10">
          <div class="flex flex-wrap items-center gap-3">
            <span class="rounded-full bg-ink px-3 py-1 text-xs font-semibold text-white">{c.sector}</span>
            {c.services.map((s) => (
              <span class="rounded-full bg-cloud px-3 py-1 text-xs font-semibold text-ink/60">{s}</span>
            ))}
          </div>
          <h2 class="mt-4 text-2xl sm:text-3xl">{c.headline}</h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-3">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink/45">Punto de partida</p>
              <p class="mt-2 text-sm leading-relaxed text-ink/75">{c.start}</p>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink/45">Qué hicimos</p>
              <p class="mt-2 text-sm leading-relaxed text-ink/75">{c.work}</p>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink/45">Qué pasó</p>
              <p class="mt-2 text-sm leading-relaxed text-ink/75">{c.outcome}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <CtaSection title="¿Quieres ser el próximo caso?" />
</BaseLayout>
