---
import BaseLayout from "../layouts/BaseLayout.astro";
import { services } from "../data/services";
import { primaryCta } from "../data/site";
---
<BaseLayout title="Página no encontrada" noindex>
  <section class="container-page flex flex-col items-center py-24 text-center">
    <p class="groovy text-7xl text-magenta-500 sm:text-8xl">404</p>
    <h1 class="mt-4 text-3xl sm:text-4xl">Esta página ha despegado sin ti.</h1>
    <p class="prose-lr mt-3 max-w-md">
      El enlace que buscas no existe o ha cambiado de sitio. Prueba con uno de estos:
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-dark">Inicio</a>
      {services.map((s) => <a href={`/${s.slug}`} class="btn-dark">{s.name}</a>)}
      <a href="/blog" class="btn-dark">Blog</a>
    </div>
    <a href={primaryCta.href} class="btn-primary mt-8">{primaryCta.label}</a>
  </section>
</BaseLayout>
