---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import ServiceCard from "../components/ServiceCard.astro";
import Steps from "../components/Steps.astro";
import CtaSection from "../components/CtaSection.astro";
import Reveal from "../components/Reveal.astro";
import Marquee from "../components/Marquee.astro";
import { services } from "../data/services";
import { primaryCta, secondaryCta, processSteps } from "../data/site";
import { getFeaturedResult } from "../data/results";

const featured = getFeaturedResult();
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-ink text-white">
    <div class="pointer-events-none absolute inset-0 opacity-70">
      <div class="animate-blob absolute -top-40 right-[-8rem] h-[34rem] w-[34rem] bg-magenta-500/30 blur-3xl"></div>
      <div class="animate-blob absolute -bottom-48 -left-32 h-[32rem] w-[32rem] bg-cyan-500/25 blur-3xl" style="animation-delay:-6s"></div>
      <div class="animate-float-slow absolute left-1/2 top-10 h-64 w-64 rounded-full bg-purple-500/25 blur-3xl"></div>
    </div>

    <div class="container-page relative grid gap-12 py-20 lg:grid-cols-[1.15fr_0.85fr] lg:py-28">
      <div>
        <Reveal as="span" class="eyebrow text-cyan-400">
          <Icon name="rocket" class="h-4 w-4 animate-float" /> Agencia de marketing digital
        </Reveal>
        <Reveal as="h1" delay={80} class="mt-5 text-4xl leading-[1.03] sm:text-5xl lg:text-[4rem]">
          Webs que <span class="text-gradient">venden</span><br class="hidden sm:block" />
          y campañas que <span class="groovy text-lime-500">traen clientes</span>.
        </Reveal>
        <Reveal as="p" delay={160} class="mt-6 max-w-xl text-lg text-white/70">
          Tanto si aún no tienes web como si ya la tienes y quieres que traiga clientes:
          montamos la presencia digital que hace que te contacten, y la mantenemos funcionando.
        </Reveal>
        <Reveal delay={240} class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={primaryCta.href} class="btn-primary">{primaryCta.label}</a>
          <a href={secondaryCta.href} class="btn-ghost">{secondaryCta.label}</a>
        </Reveal>
      </div>

      <div class="relative self-center">
        <ul class="grid content-start gap-3">
          {services.map((s, i) => (
            <Reveal as="li" variant="right" delay={i * 90}>
              <a href={`/${s.slug}`} class="group flex items-center justify-between gap-4 rounded-2xl border border-white/12 bg-white/5 px-5 py-4 backdrop-blur transition hover:border-white/40 hover:bg-white/10">
                <span>
                  <span class="font-display font-semibold">{s.name}</span>
                  <span class="block text-sm text-white/55">{s.descriptor}</span>
                </span>
                <span class="link-arrow"><Icon name="arrow" class="h-4 w-4 text-white/60" /></span>
              </a>
            </Reveal>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <div class="border-y-2 border-ink bg-lime-500 py-3 text-ink">
    <Marquee items={["Diseño Web", "Paid Media", "SEO Local", "GEO · IA", "Social Media", "Diagnóstico gratis", "Webs que venden"]} />
  </div>

  <!-- Servicios -->
  <section class="container-page py-20 sm:py-24">
    <Reveal class="max-w-2xl">
      <span class="eyebrow"><Icon name="rocket" class="h-4 w-4" /> Qué hacemos</span>
      <h2 class="mt-4 text-3xl sm:text-4xl">
        Cuatro servicios, un mismo objetivo: <span class="text-gradient">que te contacten más</span>.
      </h2>
      <p class="prose-lr mt-4">
        Cada uno se contrata por separado y se presupuesta caso a caso. Sin paquetes cerrados,
        sin precios en la web: primero hablamos de tu caso.
      </p>
    </Reveal>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s, i) => (
        <Reveal variant="scale" delay={i * 90} class="h-full">
          <ServiceCard service={s} />
        </Reveal>
      ))}
    </div>
  </section>

  <!-- Cómo trabajamos -->
  <section class="relative overflow-hidden bg-cloud py-20 sm:py-24">
    <div class="animate-blob pointer-events-none absolute -right-24 top-0 h-72 w-72 bg-purple-500/15 blur-3xl"></div>
    <div class="container-page relative">
      <Reveal>
        <span class="eyebrow"><Icon name="rocket" class="h-4 w-4" /> Cómo trabajamos</span>
      </Reveal>
      <Reveal delay={80} class="mt-4">
        <Steps steps={processSteps} title="De la primera llamada al informe mensual." />
      </Reveal>
    </div>
  </section>

  <!-- Un resultado real -->
  <section class="container-page py-20 sm:py-24">
    <Reveal variant="scale" class="grid items-start gap-10 rounded-[2rem] border-2 border-ink/10 bg-white p-8 shadow-[0_40px_80px_-50px_rgba(25,10,51,0.4)] sm:p-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <span class="eyebrow"><Icon name="target" class="h-4 w-4" /> Un caso, no una galería</span>
        <p class="mt-4 text-sm font-semibold text-ink/50">{featured.sector}</p>
        <h2 class="mt-2 text-2xl sm:text-3xl">{featured.headline}</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {featured.services.map((s) => (
            <span class="rounded-full bg-cloud px-3 py-1 text-xs font-semibold text-ink/60">{s}</span>
          ))}
        </div>
        <a href="/resultados" class="btn-dark link-arrow mt-6 inline-flex">
          Ver todos los casos <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
      <dl class="grid gap-4">
        <div class="rounded-2xl bg-cloud p-5">
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink/50">Punto de partida</dt>
          <dd class="mt-1.5 text-sm leading-relaxed text-ink/75">{featured.start}</dd>
        </div>
        <div class="rounded-2xl bg-cloud p-5">
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink/50">Qué hicimos</dt>
          <dd class="mt-1.5 text-sm leading-relaxed text-ink/75">{featured.work}</dd>
        </div>
      </dl>
    </Reveal>
  </section>

  <!-- Quiénes somos, breve -->
  <section class="border-t border-ink/10 bg-cloud py-20 sm:py-24">
    <div class="container-page max-w-3xl">
      <Reveal>
        <span class="eyebrow"><Icon name="rocket" class="h-4 w-4" /> Quiénes somos</span>
      </Reveal>
      <Reveal as="h2" delay={80} class="mt-4 text-3xl sm:text-4xl">
        Un equipo pequeño que se mete en cada proyecto <span class="text-gradient">como si fuera propio</span>.
      </Reveal>
      <Reveal as="p" delay={150} class="prose-lr mt-4 max-w-xl">
        Marketing, diseño web y tecnología bajo el mismo techo. Trabajamos desde España con
        negocios locales y pymes que quieren crecer sin montar un departamento entero.
      </Reveal>
      <Reveal delay={220} class="mt-6">
        <a href="/sobre-nosotros" class="link-arrow inline-flex items-center gap-1.5 font-display text-sm font-bold text-magenta-600">
          Conócenos <Icon name="arrow" class="h-4 w-4" />
        </a>
      </Reveal>
    </div>
  </section>

  <CtaSection />
</BaseLayout>
