---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import ServiceCard from "../components/ServiceCard.astro";
import Steps from "../components/Steps.astro";
import CtaSection from "../components/CtaSection.astro";
import { services } from "../data/services";
import { primaryCta, secondaryCta, processSteps, team } from "../data/site";
import { getFeaturedResult } from "../data/results";

const featured = getFeaturedResult();
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-ink text-white">
    <div class="pointer-events-none absolute -top-40 right-0 h-[32rem] w-[32rem] rounded-full bg-magenta-500/25 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-40 -left-24 h-[28rem] w-[28rem] rounded-full bg-cyan-500/20 blur-3xl"></div>
    <div class="container-page relative grid gap-12 py-20 lg:grid-cols-[1.15fr_0.85fr] lg:py-28">
      <div>
        <span class="eyebrow text-cyan-400"><Icon name="rocket" class="h-4 w-4" /> Agencia de marketing digital</span>
        <h1 class="mt-5 text-4xl leading-[1.05] sm:text-5xl lg:text-6xl">
          Webs que venden y campañas que traen clientes.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-white/70">
          Tanto si aún no tienes web como si ya la tienes y quieres que traiga clientes:
          montamos la presencia digital que hace que te contacten, y la mantenemos funcionando.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={primaryCta.href} class="btn-primary">{primaryCta.label}</a>
          <a href={secondaryCta.href} class="btn-ghost">{secondaryCta.label}</a>
        </div>
      </div>
      <ul class="grid content-start gap-3 self-center">
        {services.map((s) => (
          <li>
            <a href={`/${s.slug}`} class="flex items-center justify-between gap-4 rounded-xl border border-white/12 bg-white/5 px-5 py-4 transition hover:border-white/35 hover:bg-white/10">
              <span>
                <span class="font-display font-semibold">{s.name}</span>
                <span class="block text-sm text-white/55">{s.descriptor}</span>
              </span>
              <Icon name="arrow" class="h-4 w-4 text-white/50" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Servicios -->
  <section class="container-page py-20">
    <div class="max-w-2xl">
      <span class="eyebrow"><Icon name="rocket" class="h-4 w-4" /> Qué hacemos</span>
      <h2 class="mt-4 text-3xl sm:text-4xl">Cuatro servicios, un mismo objetivo: que te contacten más.</h2>
      <p class="prose-lr mt-4">
        Cada uno se contrata por separado y se presupuesta caso a caso. Sin paquetes cerrados,
        sin precios en la web: primero hablamos de tu caso.
      </p>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s) => <ServiceCard service={s} />)}
    </div>
  </section>

  <!-- Cómo trabajamos -->
  <section class="bg-cloud py-20">
    <div class="container-page">
      <span class="eyebrow"><Icon name="rocket" class="h-4 w-4" /> Cómo trabajamos</span>
      <div class="mt-4">
        <Steps steps={processSteps} title="De la primera llamada al informe mensual." />
      </div>
    </div>
  </section>

  <!-- Un resultado real -->
  <section class="container-page py-20">
    <div class="grid items-start gap-10 rounded-3xl border border-ink/10 bg-white p-8 sm:p-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <span class="eyebrow"><Icon name="target" class="h-4 w-4" /> Un caso, no una galería</span>
        <p class="mt-4 text-sm font-semibold text-ink/50">{featured.sector}</p>
        <h2 class="mt-2 text-2xl sm:text-3xl">{featured.headline}</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {featured.services.map((s) => (
            <span class="rounded-full bg-cloud px-3 py-1 text-xs font-semibold text-ink/60">{s}</span>
          ))}
        </div>
        <a href="/resultados" class="btn-dark mt-6 inline-flex">Ver todos los casos</a>
      </div>
      <dl class="grid gap-4">
        <div class="rounded-2xl bg-cloud p-5">
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink/50">Punto de partida</dt>
          <dd class="mt-1.5 text-sm leading-relaxed text-ink/75">{featured.start}</dd>
        </div>
        <div class="rounded-2xl bg-cloud p-5">
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink/50">Qué hicimos</dt>
          <dd class="mt-1.5 text-sm leading-relaxed text-ink/75">{featured.work}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Quiénes somos, breve -->
  <section class="bg-ink py-20 text-white">
    <div class="container-page grid gap-10 lg:grid-cols-[1fr_1fr]">
      <div>
        <span class="eyebrow text-cyan-400"><Icon name="rocket" class="h-4 w-4" /> Quiénes somos</span>
        <h2 class="mt-4 text-3xl sm:text-4xl">Un equipo pequeño que se mete en cada proyecto como si fuera propio.</h2>
        <p class="mt-4 text-white/70">
          Marketing, diseño web y tecnología bajo el mismo techo. Trabajamos desde España con
          negocios locales y pymes que quieren crecer sin montar un departamento entero.
        </p>
        <a href="/sobre-nosotros" class="btn-ghost mt-6 inline-flex">Sobre nosotros</a>
      </div>
      <ul class="grid gap-3 self-center sm:grid-cols-2">
        {team.map((m) => (
          <li class="rounded-xl border border-white/12 bg-white/5 p-4">
            <p class="font-display font-semibold">{m.name}</p>
            <p class="text-sm text-white/55">{m.role}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaSection />
</BaseLayout>
