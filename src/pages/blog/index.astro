---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import CtaSection from "../../components/CtaSection.astro";
import Reveal from "../../components/Reveal.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
// Rejilla de 3 columnas: si sobran 2 celdas en la última fila, el primer artículo ocupa 2 columnas.
const featureFirst = posts.length > 3 && posts.length % 3 === 2;
const fmt = (d: Date) =>
  d.toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });
const catColor: Record<string, string> = {
  "Diseño Web": "text-magenta-600",
  "Paid Media": "text-cyan-600",
  "SEO Local & GEO": "text-lime-600",
  "Social Media": "text-purple-600",
  General: "text-ink/50",
};
---

<BaseLayout
  title="Blog"
  description="Ideas prácticas sobre diseño web, publicidad, SEO local y redes para negocios que quieren más clientes."
>
  <section class="relative overflow-hidden bg-ink text-white">
    <div class="animate-blob pointer-events-none absolute -right-24 -top-24 h-96 w-96 bg-purple-500/25 blur-3xl"></div>
    <div class="container-page relative py-16 lg:py-24">
      <Reveal as="span" class="eyebrow text-cyan-400">Blog</Reveal>
      <Reveal as="h1" delay={80} class="mt-5 max-w-3xl text-4xl leading-[1.05] sm:text-5xl lg:text-6xl">
        Marketing digital <span class="groovy text-lime-500">sin humo</span>.
      </Reveal>
      <Reveal as="p" delay={150} class="mt-5 max-w-2xl text-lg text-white/70">
        Lo que le contamos a un cliente en la primera reunión, por escrito. Sin tecnicismos
        innecesarios.
      </Reveal>
    </div>
  </section>

  <div class="container-page section-y">
    {posts.length === 0 ? (
      <p class="prose-lr">Todavía no hay artículos publicados.</p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, i) => (
          <Reveal variant="scale" delay={(i % 3) * 90} class={`h-full ${i === 0 && featureFirst ? "lg:col-span-2" : ""}`}>
            <a href={`/blog/${post.id}`} class="group card-hover flex h-full flex-col overflow-hidden rounded-2xl border-2 border-ink/10 bg-white p-6 hover:border-ink/20">
              <span class={`text-xs font-semibold uppercase tracking-[0.14em] ${catColor[post.data.category] ?? "text-cyan-600"}`}>
                {post.data.category}
              </span>
              <h2 class="mt-3 text-xl leading-snug">{post.data.title}</h2>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink/70">{post.data.description}</p>
              <span class="mt-4 flex items-center justify-between text-xs text-ink/45">
                {fmt(post.data.pubDate)}
                <span class="link-arrow text-magenta-600"><Icon name="arrow" class="h-4 w-4" /></span>
              </span>
            </a>
          </Reveal>
        ))}
      </div>
    )}
  </div>

  <CtaSection />
</BaseLayout>
