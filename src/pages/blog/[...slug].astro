---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import CtaSection from "../../components/CtaSection.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) =>
  d.toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <header class="bg-ink text-white">
      <div class="container-page py-16 lg:py-20">
        <a href="/blog" class="flex items-center gap-2 text-sm text-white/50 hover:text-white">
          <Icon name="arrow" class="h-3 w-3 rotate-180" /> Blog
        </a>
        <span class="mt-6 inline-block text-xs font-semibold uppercase tracking-[0.14em] text-cyan-400">
          {post.data.category}
        </span>
        <h1 class="mt-3 max-w-3xl text-3xl leading-tight sm:text-4xl">{post.data.title}</h1>
        <p class="mt-4 text-sm text-white/55">
          {fmt(post.data.pubDate)} · {post.data.author}
        </p>
      </div>
    </header>

    <div class="container-page py-14 sm:py-16">
      <div class="post-body mx-auto max-w-2xl">
        <Content />
      </div>
    </div>
  </article>

  <CtaSection />
</BaseLayout>

<style is:global>
  .post-body { color: color-mix(in srgb, var(--color-ink) 82%, transparent); font-size: 1.05rem; line-height: 1.75; }
  .post-body > * + * { margin-top: 1.15rem; }
  .post-body h2 { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; margin-top: 2.5rem; color: var(--color-ink); }
  .post-body h3 { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; margin-top: 1.75rem; color: var(--color-ink); }
  .post-body ul { list-style: disc; padding-left: 1.25rem; }
  .post-body ol { list-style: decimal; padding-left: 1.25rem; }
  .post-body li + li { margin-top: 0.4rem; }
  .post-body a { color: var(--color-magenta-600); text-decoration: underline; text-underline-offset: 2px; }
  .post-body strong { color: var(--color-ink); }
  .post-body blockquote { border-left: 3px solid var(--color-magenta-500); padding-left: 1rem; font-style: italic; color: color-mix(in srgb, var(--color-ink) 65%, transparent); }
</style>
