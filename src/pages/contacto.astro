---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import ContactForm from "../components/ContactForm.astro";
import Reveal from "../components/Reveal.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Contacto"
  description="Cuéntanos tu caso. Consultoría gratuita y sin compromiso. Respondemos en menos de 24 h laborables."
>
  <section class="relative overflow-hidden bg-ink text-white">
    <div class="animate-blob pointer-events-none absolute -right-24 -top-24 h-96 w-96 bg-lime-500/15 blur-3xl"></div>
    <div class="container-page relative py-16 lg:py-20">
      <Reveal as="span" class="eyebrow text-cyan-400"><Icon name="rocket" class="h-4 w-4 animate-float" /> Contacto</Reveal>
      <Reveal as="h1" delay={80} class="mt-5 max-w-3xl text-4xl leading-[1.05] sm:text-5xl lg:text-6xl">
        Hablemos de <span class="text-gradient">tu negocio</span>.
      </Reveal>
      <Reveal as="p" delay={150} class="mt-5 max-w-2xl text-lg text-white/70">
        Cuéntanos tu situación y te decimos cómo podemos ayudarte. Sin compromiso.
      </Reveal>
    </div>
  </section>

  <div class="container-page grid gap-10 py-16 sm:py-20 lg:grid-cols-[1.2fr_0.8fr]">
    <div>
      <h2 class="text-2xl">Escríbenos</h2>
      <p class="prose-lr mt-2 text-base">Campos con * obligatorios. Te respondemos en menos de 24 h laborables.</p>
      <div class="mt-6"><ContactForm /></div>
    </div>

    <aside class="space-y-4">
      <a href={site.whatsapp} class="flex items-center gap-4 rounded-2xl border border-ink/10 bg-white p-5 transition hover:border-ink/25">
        <span class="grid h-11 w-11 place-items-center rounded-xl bg-cyan-500/10 text-cyan-600"><Icon name="whatsapp" class="h-6 w-6" /></span>
        <span><span class="block font-display font-semibold">WhatsApp</span><span class="text-sm text-ink/60">{site.phone}</span></span>
      </a>
      <a href={`tel:${site.phoneHref}`} class="flex items-center gap-4 rounded-2xl border border-ink/10 bg-white p-5 transition hover:border-ink/25">
        <span class="grid h-11 w-11 place-items-center rounded-xl bg-magenta-500/10 text-magenta-500"><Icon name="phone" class="h-6 w-6" /></span>
        <span><span class="block font-display font-semibold">Teléfono</span><span class="text-sm text-ink/60">{site.phone}</span></span>
      </a>
      <a href={`mailto:${site.email}`} class="flex items-center gap-4 rounded-2xl border border-ink/10 bg-white p-5 transition hover:border-ink/25">
        <span class="grid h-11 w-11 place-items-center rounded-xl bg-lime-500/15 text-lime-600"><Icon name="mail" class="h-6 w-6" /></span>
        <span><span class="block font-display font-semibold">Email</span><span class="text-sm text-ink/60">{site.email}</span></span>
      </a>
      <div class="rounded-2xl border border-ink/10 bg-cloud p-5 text-sm text-ink/70">
        <p class="font-display font-semibold text-ink">Horario</p>
        <p class="mt-1">{site.hours}</p>
        <a href="/cita" class="mt-3 inline-flex items-center gap-1.5 font-semibold text-magenta-600">
          ¿Prefieres agendar una llamada? <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    </aside>
  </div>
</BaseLayout>
