---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaSection from "../components/CtaSection.astro";
import Reveal from "../components/Reveal.astro";
import { site, team } from "../data/site";

const valores = [
  { t: "Simpleza", d: "Menos ruido, más claridad. Cada acción tiene un porqué que te podemos explicar en una frase." },
  { t: "Orientación a resultado", d: "Trabajamos sobre números concretos: contactos, llamadas, formularios. No sobre impresiones vacías." },
  { t: "Transparencia", d: "Tú apruebas lo que sale a la calle. Informe cada mes, sin jerga y sin letra pequeña." },
  { t: "Cercanía", d: "Equipo pequeño. Hablas con quien hace el trabajo, no con una capa de gestión." },
];
---

<BaseLayout
  title="Sobre nosotros"
  description="Quiénes somos, desde cuándo y cómo trabajamos en Like A Rocket."
>
  <section class="relative overflow-hidden bg-ink text-white">
    <div class="animate-blob pointer-events-none absolute -right-24 -top-24 h-96 w-96 bg-magenta-500/25 blur-3xl"></div>
    <div class="container-page relative py-16 lg:py-24">
      <Reveal as="span" class="eyebrow text-cyan-400">Sobre nosotros</Reveal>
      <Reveal as="h1" delay={80} class="mt-5 max-w-3xl text-4xl leading-[1.05] sm:text-5xl lg:text-6xl">
        Una agencia pequeña, metida en cada proyecto <span class="text-gradient">como si fuera suyo</span>.
      </Reveal>
      <Reveal as="p" delay={150} class="mt-5 max-w-2xl text-lg text-white/70">
        {site.legalName}. Marketing, diseño web y tecnología bajo el mismo techo, trabajando
        desde España con negocios locales y pymes.
      </Reveal>
    </div>
  </section>

  <section class="container-page py-16 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_1fr]">
      <div>
        <h2 class="text-2xl sm:text-3xl">Cómo trabajamos</h2>
        <div class="prose-lr mt-4 space-y-4">
          <p>
            Empezamos siempre por un diagnóstico: entender el negocio, el sector y a dónde quiere
            llegar. De ahí sale una propuesta concreta, con un orden y un número que esperamos mover.
          </p>
          <p>
            Ejecutamos por fases, enseñando el trabajo antes de publicarlo, y cada mes entregamos
            un informe de lo que se hizo y cómo evolucionan las métricas. Sin permanencias
            innecesarias y sin paquetes cerrados: cada servicio se presupuesta caso a caso.
          </p>
        </div>
      </div>
      <div>
        <h2 class="text-2xl sm:text-3xl">Lo que nos importa</h2>
        <ul class="mt-4 space-y-3">
          {valores.map((v, i) => (
            <Reveal as="li" variant="right" delay={i * 80} class="card-hover rounded-2xl border-2 border-ink/10 bg-white p-5">
              <p class="font-display font-semibold">{v.t}</p>
              <p class="mt-1 text-sm leading-relaxed text-ink/70">{v.d}</p>
            </Reveal>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- El equipo -->
  <section class="container-page py-16 sm:py-20 border-t border-ink/10">
    <Reveal>
      <span class="eyebrow">El equipo</span>
      <h2 class="mt-3 text-3xl sm:text-4xl">Las personas detrás de cada despegue.</h2>
      <p class="prose-lr mt-3 max-w-2xl">
        Sin capas intermedias de ejecutivos ni jerga vacía: hablas y trabajas directamente con los especialistas técnicos y estratégicos que ejecutan tu proyecto.
      </p>
    </Reveal>

    <div class="mx-auto mt-10 grid max-w-2xl gap-6 sm:grid-cols-2">
      {team.map((member, i) => (
        <Reveal variant="scale" delay={i * 90}>
          <div class="card-hover group overflow-hidden rounded-[2rem] border border-ink/10 bg-white p-5 text-center shadow-sm hover:border-magenta-500/30">
            <div class="mx-auto aspect-square w-full max-w-[240px] overflow-hidden rounded-[1.25rem] bg-cloud">
              <img
                src={member.avatar}
                alt={member.name}
                width="400"
                height="400"
                class="block h-full w-full object-cover object-center"
                loading="lazy"
              />
            </div>
            <div class="mt-4 px-2 pb-2">
              <h3 class="font-display font-bold text-lg text-ink">{member.name}</h3>
              <p class="text-xs font-semibold text-magenta-600 mt-0.5">{member.role}</p>
              <div class="mt-2 inline-flex items-center rounded-full bg-cloud px-3 py-1 text-[11px] font-medium text-ink/75">
                {member.specialty}
              </div>
            </div>
          </div>
        </Reveal>
      ))}
    </div>
  </section>

  <section class="container-page py-16">
    <div class="grid gap-6 rounded-3xl border border-ink/10 bg-white p-8 sm:grid-cols-2 sm:p-12">
      <div>
        <h2 class="text-xl">Dónde estamos</h2>
        <p class="prose-lr mt-2 text-base">Trabajamos en remoto con clientes de toda España. {site.hours}.</p>
      </div>
      <div>
        <h2 class="text-xl">Cómo contactar</h2>
        <ul class="mt-2 space-y-1.5 text-sm text-ink/75">
          <li><a class="hover:text-magenta-600" href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
          <li><a class="hover:text-magenta-600" href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </div>
    </div>
  </section>

  <CtaSection />
</BaseLayout>
