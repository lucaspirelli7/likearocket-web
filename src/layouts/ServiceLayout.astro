---
import BaseLayout from "./BaseLayout.astro";
import Icon from "../components/Icon.astro";
import CtaSection from "../components/CtaSection.astro";
import MetricNote from "../components/MetricNote.astro";
import { getService, services } from "../data/services";
import { primaryCta } from "../data/site";

interface Props {
  slug: string;
  intro: string;
}
const { slug, intro } = Astro.props;
const service = getService(slug)!;
const others = services.filter((s) => s.slug !== slug);

const accentText = {
  magenta: "text-magenta-400",
  cyan: "text-cyan-400",
  lime: "text-lime-500",
}[service.accent];
---

<BaseLayout title={`${service.name} — ${service.descriptor}`} description={service.promise}>
  <section class="relative overflow-hidden bg-ink text-white">
    <div class="pointer-events-none absolute -top-32 right-0 h-96 w-96 rounded-full bg-magenta-500/20 blur-3xl"></div>
    <div class="container-page relative py-16 lg:py-24">
      <p class="flex items-center gap-2 text-sm text-white/50">
        <a href="/" class="hover:text-white">Inicio</a>
        <Icon name="arrow" class="h-3 w-3" />
        <span class={accentText}>{service.name}</span>
      </p>
      <h1 class="mt-5 max-w-3xl text-4xl leading-tight sm:text-5xl">{service.descriptor}</h1>
      <p class="mt-5 max-w-2xl text-lg text-white/70">{intro}</p>
      <a href={primaryCta.href} class="btn-primary mt-8">{primaryCta.label}</a>
    </div>
  </section>

  <div class="container-page space-y-16 py-16 sm:space-y-20 sm:py-20">
    <slot />

    <MetricNote>{service.metric}</MetricNote>
  </div>

  <section class="bg-cloud py-16">
    <div class="container-page">
      <h2 class="text-2xl">Otros servicios</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {others.map((s) => (
          <a href={`/${s.slug}`} class="rounded-2xl border border-ink/10 bg-white p-5 transition hover:border-ink/25">
            <p class="font-display font-semibold">{s.name}</p>
            <p class="mt-1 text-sm text-ink/60">{s.descriptor}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaSection />
</BaseLayout>
