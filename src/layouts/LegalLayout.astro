---
import BaseLayout from "./BaseLayout.astro";
interface Props { title: string }
const { title } = Astro.props;
---
<BaseLayout title={title} noindex>
  <div class="container-page py-16 sm:py-20">
    <div class="mx-auto max-w-2xl">
      <h1 class="text-3xl sm:text-4xl">{title}</h1>
      <div class="mb-8 mt-6 rounded-xl border border-lime-500/40 bg-lime-500/10 p-4 text-sm text-ink/70">
        Marcador de posición. Este texto debe sustituirse por la versión definitiva revisada
        (auditoría legal) antes del lanzamiento.
      </div>
      <div class="post-body space-y-4 text-ink/80">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>
<style is:global>
  .post-body h2 { font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; margin-top: 2rem; color: var(--readable); }
  .post-body p { line-height: 1.7; }
</style>
