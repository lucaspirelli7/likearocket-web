# Copia este archivo a `.env` y rellena los valores.
# Las variables PUBLIC_* se exponen al navegador (Astro).

# Endpoint del formulario de contacto (Formspree, Web3Forms, Getform...).
# Si se deja vacío, el formulario hace fallback a un enlace mailto.
PUBLIC_FORM_ENDPOINT=

# URL del widget de reserva de cita (Cal.com / Calendly) para incrustar en /cita.
# Si se deja vacío, /cita muestra el formulario de contacto como alternativa.
PUBLIC_BOOKING_URL=
